# Build: gera o estático em /app/dist (o Dockerfile normal roda "vite dev" e não serve pra isso).
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# import.meta.env.VITE_* é substituído em tempo de build pelo Vite — não existe leitura de
# variável de ambiente em runtime num SPA estático, por isso precisa ser um ARG do build.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Runtime: nginx leve só pra servir os arquivos estáticos gerados acima.
FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
